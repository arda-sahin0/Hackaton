# ── Demo safety (directive §5.3) ───────────────────────────────────────────────────────────
# true  -> never touch a network; replay the pre-verified tx hashes below after a 2s delay.
# false -> live testnet calls; on timeout / RPC error the adapter still degrades to the replay.
NEXT_PUBLIC_DEMO_FALLBACK=true
NEXT_PUBLIC_DEFAULT_NETWORK=cardano-preprod        # cardano-preprod | bsv-testnet | evm-sepolia
NEXT_PUBLIC_PROJECT_TITLE=Citation Escrow · Agentic Research Payments
NEXT_PUBLIC_AGENT_MAX_AMOUNT=1                     # hard cap per agent action, in base currency

# ── Pre-verified testnet tx hashes replayed by the fallback (replace at kickoff) ───────────
NEXT_PUBLIC_FALLBACK_TX_CARDANO=48eaf21bb25e9831206537ff78939e84400015168e9c93e2a8227cbfe029a1b5   # real: paid x402 /verify on preprod
NEXT_PUBLIC_FALLBACK_TX_BSV=REPLACE_WITH_64_HEX_TESTNET_TXID
NEXT_PUBLIC_FALLBACK_TX_EVM=0xREPLACE_WITH_64_HEX_SEPOLIA_TX_HASH

# ── Recipients for the happy-path transfer ────────────────────────────────────────────────
NEXT_PUBLIC_RECIPIENT_CARDANO=addr_test1REPLACE
NEXT_PUBLIC_RECIPIENT_BSV=REPLACE_TESTNET_ADDRESS
NEXT_PUBLIC_RECIPIENT_EVM=0x0000000000000000000000000000000000000000

# ── LLM orchestration (server-side only) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=                                 # leave empty -> deterministic mock reasoning
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low                               # low | medium | high | xhigh | max
AGENT_LLM_MODE=auto                                # auto | live | mock
ANTHROPIC_TIMEOUT_MS=10000                         # per-step cap when live; demo fallback never calls the LLM

# ── Cardano Preprod (MeshJS / Lucid + Blockfrost) ─────────────────────────────────────────
BLOCKFROST_PROJECT_ID=
NEXT_PUBLIC_CARDANO_RPC_URL=https://cardano-preprod.blockfrost.io/api/v0
CARDANO_AGENT_MNEMONIC=                            # server-side agent wallet, NEVER commit
CARDANO_WATCH_ADDRESS=                             # balance card; default: the Masumi escrow address
# ── Citation-escrow workflow (cardano/ package is run as a child process; its own cardano/.env applies) ──
RESEARCH_MODE=fixture                              # fixture | model — model needs the Sokosumi quickstart's provider key
RESEARCH_PAY_VERIFY=false                          # true: the research agent pays the x402 verifier per DOI (live mode)
CARDANO_LOCK_TX_HASH=                              # a live Masumi lock tx the hirer may refund (live mode); empty -> replay

# ── BSV Testnet (WhatsOnChain) ────────────────────────────────────────────────────────────
WHATSONCHAIN_API_KEY=
NEXT_PUBLIC_BSV_RPC_URL=https://api.whatsonchain.com/v1/bsv/test
BSV_PRIVATE_KEY_WIF=                               # testnet WIF, NEVER commit

# ── EVM Sepolia + API3 (viem / wagmi / RainbowKit) ────────────────────────────────────────
EVM_RPC_URL=
NEXT_PUBLIC_EVM_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_EVM_CHAIN_ID=11155111                  # 421614 Arbitrum Sepolia · 84532 Base Sepolia
NEXT_PUBLIC_EVM_EXPLORER_BASE=https://sepolia.etherscan.io
NEXT_PUBLIC_API3_PROXY_ADDRESS=                    # Api3ReaderProxyV1 for the dAPI you read
AGENT_PRIVATE_KEY=                                 # 0x… test key, NEVER commit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=              # RainbowKit
