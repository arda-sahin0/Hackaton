# Blockfrost project id for Cardano PREPROD (https://blockfrost.io), starts with "preprod".
BLOCKFROST_PROJECT_ID=

# Fresh test wallets only (24 words each). Never a wallet with real funds. Never commit .env.
# Hirer / buyer: locks jobs in escrow, requests and withdraws refunds.
BUYER_MNEMONIC=
# Research agent / seller: needed only to accept a refund (AuthorizeRefund) in the demo.
SELLER_MNEMONIC=
