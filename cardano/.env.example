# Blockfrost project id for Cardano PREPROD (https://blockfrost.io), starts with "preprod".
BLOCKFROST_PROJECT_ID=

# Fresh test wallets only (24 words each). Never a wallet with real funds. Never commit .env.
# Buyer: locks the payment in escrow, requests and withdraws refunds.
BUYER_MNEMONIC=
# Seller: needed only to accept a refund (AuthorizeRefund) in the demo.
SELLER_MNEMONIC=

# ---- Buyer agent (npm run hire) ----------------------------------------------
# The seller agent's x402 endpoint (Masumi escrow offer), e.g. https://<agent>/x402/start_job/ada
AGENT_OFFER_URL=
# The most the buyer locks for one job, in lovelace (price + Masumi's refundable collateral).
HIRE_MAX_LOVELACE=10000000
