# Blockfrost project id for Cardano PREPROD (https://blockfrost.io), starts with "preprod".
BLOCKFROST_PROJECT_ID=

# Fresh test wallets only (24 words each). Never a wallet with real funds. Never commit .env.
# Hirer / buyer: locks jobs in escrow, requests and withdraws refunds.
BUYER_MNEMONIC=
# Research agent / seller: needed only to accept a refund (AuthorizeRefund) in the demo.
SELLER_MNEMONIC=

# ---- Citation verifier (npm run verify-server) -------------------------------
# Preprod address that receives the verification fees.
VERIFY_PAY_TO=
# Price per lookup in lovelace (1 tADA; smaller outputs fall below Cardano's minimum UTxO).
VERIFY_PRICE_LOVELACE=1000000
VERIFY_PORT=4030
# Hosted Cardano Foundation facilitator (verifies and broadcasts payments).
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
# Optional, EVM: an account with aUSD on Base Sepolia for LIVE signed OpenAlex lookups (0.01 aUSD each).
# Without it the verifier replays the signed fixtures in api3evm/test/fixtures (real Airnode signatures).
PAYER_PRIVATE_KEY=

# ---- Paying client (npm run pay-verify) ---------------------------------------
VERIFY_URL=http://localhost:4030
# The most the agent pays per call, in lovelace.
VERIFY_MAX_LOVELACE=3000000

# ---- Hirer agent (npm run hire) ----------------------------------------------
# The research agent's x402 endpoint (Masumi escrow offer), e.g. https://<agent>/x402/start_job/ada
AGENT_OFFER_URL=
# The most the hirer locks for one job, in lovelace (price + Masumi's refundable collateral).
HIRE_MAX_LOVELACE=10000000

# ---- Research agent (Sokosumi Coworker; see research-agent/setup.sh) ----------
# IDs are not secrets. Vendor "Citation Escrow", Coworker "Research Agent (citation-verified)".
COWORKER_ID=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
# model (default) | fixture: replay the saved report, no model key needed (demo safety)
RESEARCH_MODE=model
# none | retracted | tamper — the "cheating seller" for the pay-vs-refund demo
RESEARCH_CHEAT=none
# true: the research agent pays the x402 verifier (VERIFY_URL) per DOI from SELLER_MNEMONIC
RESEARCH_PAY_VERIFY=false
# Optional polite-pool contact for the free OpenAlex pre-check.
OPENALEX_MAILTO=

# ---- CitationEscrow on Base Sepolia (API3 side) -------------------------------
# Leave empty until deployed; the pipeline then records "skipped".
CITATION_ESCROW_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Researcher's EVM key for createJob/deliver/proveSource (needs Base Sepolia ETH for gas).
RESEARCHER_EVM_PRIVATE_KEY=
