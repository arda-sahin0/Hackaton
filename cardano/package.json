    "pay-verify": "node --env-file-if-exists=.env src/cli/pay-verify.ts",
    "hire": "node --env-file-if-exists=.env src/cli/hire.ts"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "0.5.13",
